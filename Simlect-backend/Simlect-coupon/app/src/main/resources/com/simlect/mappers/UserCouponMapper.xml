<mapper namespace="com.simlect.mappers.UserCouponMapper">

	<!--实体映射-->
	<resultMap id="base_result_map" type="com.simlect.entity.po.UserCoupon">
		<!--用户优惠券记录ID-->
		<result column="user_coupon_id" property="userCouponId"  />
		<!--用户ID-->
		<result column="user_id" property="userId"  />
		<!--优惠券ID-->
		<result column="coupon_id" property="couponId"  />
		<result column="receive_time" property="receiveTime"  />
		<!--使用时间-->
		<result column="use_time" property="useTime"  />
		<result column="order_id" property="orderId"  />
		<!--状态 0:未使用 1:已使用 2:已过期 3:已作废-->
		<result column="status" property="status"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 u.user_coupon_id,u.user_id,u.coupon_id,
		 u.receive_time,u.use_time,u.order_id,u.status
	</sql>

	<sql id="base_condition_filed">
			<if test="query.userCouponId != null and query.userCouponId!=''">
				 and  u.user_coupon_id = #{query.userCouponId}
			</if>
			<if test="query.userId != null and query.userId!=''">
				 and  u.user_id = #{query.userId}
			</if>
			<if test="query.couponId != null and query.couponId!=''">
				 and  u.coupon_id = #{query.couponId}
			</if>
			<if test="query.useTime != null and query.useTime!=''">
				 <![CDATA[ and  u.use_time=str_to_date(#{query.useTime}, '%Y-%m-%d %H:%i:%s') ]]>
			</if>
			<if test="query.status != null">
				 and  u.status = #{query.status}
			</if>
			<if test="query.executeStatusList != null and query.executeStatusList.length > 0">
				and u.status not in
				<foreach item="item" collection="query.executeStatusList" separator="," open="(" close=")">
					#{item}
				</foreach>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.userCouponIdFuzzy!= null  and query.userCouponIdFuzzy!=''">
				 and  u.user_coupon_id like concat('%', #{query.userCouponIdFuzzy}, '%')
			</if>
			<if test="query.userIdFuzzy!= null  and query.userIdFuzzy!=''">
				 and  u.user_id like concat('%', #{query.userIdFuzzy}, '%')
			</if>
			<if test="query.couponIdFuzzy!= null  and query.couponIdFuzzy!=''">
				 and  u.coupon_id like concat('%', #{query.couponIdFuzzy}, '%')
			</if>
			<if test="query.useTimeStart!= null and query.useTimeStart!=''">
				 <![CDATA[ and  u.use_time>=str_to_date(#{query.useTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.useTimeEnd!= null and query.useTimeEnd!=''">
				 <![CDATA[ and  u.use_time< date_sub(str_to_date(#{query.useTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM user_coupon u <include refid="query_condition" />
		 <if test="query.orderBy!=null">
			 order by ${query.orderBy}
		 </if>
		 <if test="query.simplePage!=null">
			 limit #{query.simplePage.start},#{query.simplePage.end}
		 </if>
	</select>

	<!-- 查询数量-->
	<select id="selectCount" resultType="java.lang.Integer" >
		 SELECT count(1) FROM user_coupon u <include refid="query_condition" />
	</select>

