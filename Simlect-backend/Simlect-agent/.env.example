# ============ 服务端口（HTTP + WebSocket 同端口） ============
# 密钥只放本文件（已 gitignore）。勿写入 IDEA Run Configuration / workspace.xml，勿提交仓库。
APP_HOST=0.0.0.0
APP_PORT=7050
# Java 仅经 Gateway；/internal/** 与 /api/** 共用 JAVA_WEB_URL
JAVA_WEB_URL=http://localhost:8080
SIMLECT_INTERNAL_TOKEN=your-token
# 内部读后端：http=微服务（经 Gateway /internal）；db=单体版服务器（直连 MySQL 适配）
INTERNAL_READ_BACKEND=http
# MCP Streamable HTTP（独立进程 python -m app.mcp_server，默认 :7060/mcp）
MCP_SERVER_URL=http://127.0.0.1:7060

# ============ LLM ============
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_FALLBACK_MODEL=deepseek-flash
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ============ 记忆摘要 LLM（可与主对话分离；留空则回落主 LLM） ============
MEMORY_LLM_API_KEY=
MEMORY_LLM_BASE_URL=
MEMORY_LLM_MODEL=
MEMORY_LLM_TIMEOUT=

# ============ Embedding ============
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# ============ MySQL（复用 Java 库） ============
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=simlect_agent

# ============ Redis ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ============ Elasticsearch ============
ES_HOSTS=http://localhost:9200
ES_INDEX=simlect_vectorstore
ES_VECTOR_DIMENSIONS=1024

# ============ RabbitMQ（与 deploy/docker-compose.middleware.yml 一致） ============
RABBITMQ_URL=amqp://simlect:simlect@localhost:5672/

# ============ Agent 配置 ============
AI_CHAT_LIMIT=200
RAG_TOP_K=15
RAG_SCORE_THRESHOLD=0.5
HISTORY_MESSAGE_LIMIT=15
TASK_QUEUE_MAX=300

# ============ 熔断 ============
CIRCUIT_LLM_FAILURE_THRESHOLD=5
CIRCUIT_LLM_RECOVERY_TIMEOUT=60
